<Application x:Class="OpenWrite.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- ================= Charte OpenWrite (assets/OpenWrite-package-complet : bleu, cyan, orange) ================= -->
        <FontFamily x:Key="UiFont">pack://application:,,,/Fonts/#DM Sans, Segoe UI</FontFamily>
        <FontFamily x:Key="TitleFont">pack://application:,,,/Fonts/#Plus Jakarta Sans, Segoe UI</FontFamily>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Color x:Key="InkColor">#111A47</Color>
        <Color x:Key="BlueColor">#087CFF</Color>
        <Color x:Key="OrangeColor">#FF8712</Color>
        <Color x:Key="CyanColor">#00C9D5</Color>
        <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}"/>
        <SolidColorBrush x:Key="Muted" Color="#4A5A80"/>
        <SolidColorBrush x:Key="Blue" Color="{StaticResource BlueColor}"/>
        <SolidColorBrush x:Key="Orange" Color="{StaticResource OrangeColor}"/>
        <SolidColorBrush x:Key="Cyan" Color="{StaticResource CyanColor}"/>
        <SolidColorBrush x:Key="Chrome" Color="#F8FBFF"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Line" Color="#DFE8FA"/>
        <SolidColorBrush x:Key="FieldBorder" Color="#D3DEF2"/>
        <SolidColorBrush x:Key="Hover" Color="#EDF4FF"/>
        <SolidColorBrush x:Key="Selected" Color="#E1E9FF"/>
        <SolidColorBrush x:Key="SelectedBorder" Color="#B9CCFF"/>
        <SolidColorBrush x:Key="SelectedText" Color="#1439C1"/>
        <!-- pastille de version (orange de la charte) -->
        <LinearGradientBrush x:Key="VersionBadge" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFF1D3" Offset="0"/>
            <GradientStop Color="#FFE1CF" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="VersionText" Color="#C85A00"/>
        <!-- compatibilite : anciennes cles -->
        <SolidColorBrush x:Key="RibbonHover" Color="#EDF4FF"/>
        <SolidColorBrush x:Key="RibbonPressed" Color="#E1E9FF"/>

        <!-- degrade de marque : boutons principaux -->
        <LinearGradientBrush x:Key="Accent" StartPoint="0,0.3" EndPoint="1,0.7">
            <GradientStop Color="#028EFF" Offset="0"/>
            <GradientStop Color="#1061E9" Offset="0.68"/>
            <GradientStop Color="#FF8B18" Offset="1"/>
        </LinearGradientBrush>
        <!-- icones du ruban -->
        <LinearGradientBrush x:Key="IconBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#03B9F7" Offset="0"/>
            <GradientStop Color="#0646C9" Offset="1"/>
        </LinearGradientBrush>
        <!-- fond de la zone de travail (comme la page de telechargement) -->
        <LinearGradientBrush x:Key="WorkspaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FCFDFF" Offset="0"/>
            <GradientStop Color="#EDF7FF" Offset="0.57"/>
            <GradientStop Color="#EEF0FF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SoftBadge" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#DCEBFF" Offset="0"/>
            <GradientStop Color="#D4F6F8" Offset="1"/>
        </LinearGradientBrush>

        <!-- ================= Controles de base ================= -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"/>
                            <!-- voile au survol (garde la couleur propre du bouton, ex. pastilles de couleur) -->
                            <Border x:Name="veil" Background="#14087CFF" CornerRadius="10" Visibility="Collapsed"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="veil" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource SelectedBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="veil" Property="Background" Value="#26087CFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                            <!-- bouton par defaut : degrade de marque -->
                            <Trigger Property="IsDefault" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="b" Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- bouton principal (Fichier, Mettre a jour) : degrade de marque, rectangle aux coins arrondis -->
        <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <Border.Effect><DropShadowEffect Color="#146AD8" BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.28"/></Border.Effect>
                            </Border>
                            <Border x:Name="veil" Background="#22FFFFFF" CornerRadius="10" Visibility="Collapsed"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="veil" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Selected}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource SelectedBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource SelectedText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Blue}"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource SelectedBorder}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
        <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>

        <!-- ================= Menus deroulants ================= -->
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <!-- ne pas heriter du gras du bouton qui ouvre le menu -->
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <!-- marge pour laisser la place a l'ombre douce -->
                        <Border Padding="10,6,10,14" Background="Transparent">
                            <Border Background="White" BorderBrush="#E3E8F5" BorderThickness="1" CornerRadius="14" Padding="6" MinWidth="220">
                                <Border.Effect><DropShadowEffect Color="#2E529A" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.18"/></Border.Effect>
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- icone, ou coche pour les options -->
                                <ContentPresenter x:Name="icon" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left" Width="20" Height="16"/>
                                <Border x:Name="check" Width="18" Height="18" CornerRadius="5" Background="{StaticResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="uncheck" Width="18" Height="18" CornerRadius="5" BorderBrush="{StaticResource FieldBorder}" BorderThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{StaticResource Muted}" FontSize="12" Margin="24,0,2,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Hover}"/>
                                <Setter Property="Foreground" Value="{StaticResource SelectedText}"/>
                            </Trigger>
                            <Trigger Property="IsCheckable" Value="True"><Setter TargetName="uncheck" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="uncheck" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{StaticResource Line}" Margin="10,5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- les separateurs de menu suivent le meme style -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}"/>

        <!-- infobulles -->
        <Style TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Padding="6,4,6,10" Background="Transparent">
                            <Border Background="{StaticResource Ink}" CornerRadius="9" Padding="10,6" MaxWidth="340">
                                <Border.Effect><DropShadowEffect Color="#111C43" BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.25"/></Border.Effect>
                                <ContentPresenter TextBlock.Foreground="White" TextBlock.FontSize="12" TextBlock.FontFamily="{StaticResource UiFont}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- elements des listes deroulantes (police, taille, epaisseur...) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="4,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bg" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Selected}"/>
                                <Setter Property="Foreground" Value="{StaticResource SelectedText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>

        <!-- ================= Ruban ================= -->
        <!-- Onglet du ruban (RadioButton), rectangle aux coins arrondis ; Tag = couleur des onglets contextuels -->
        <Style x:Key="RibbonTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#2B3A5C"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="GroupName" Value="ribbonTabs"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="dot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                         Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Selected}"/>
                                <Setter Property="Foreground" Value="{StaticResource SelectedText}"/>
                            </Trigger>
                            <!-- onglet contextuel (Tag = couleur) : pastille -->
                            <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="dot" Property="Visibility" Value="Collapsed"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Grand bouton du ruban : Tag = icone, Content = libelle -->
        <Style x:Key="RBig" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="22" HorizontalAlignment="Center" Margin="0,2,0,4" Foreground="{StaticResource IconBrush}"/>
                                <ContentPresenter HorizontalAlignment="Center" TextBlock.FontSize="11.5" TextBlock.TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Selected}"/></Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Selected}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource SelectedBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource SelectedText}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Petit bouton : icone + libelle sur une ligne -->
        <Style x:Key="RSmall" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ic" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource IconBrush}"/>
                                <ContentPresenter VerticalAlignment="Center" TextBlock.FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="ic" Property="Visibility" Value="Collapsed"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Selected}"/></Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Selected}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource SelectedBorder}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fleche de defilement du ruban (ecrans etroits) -->
        <Style x:Key="RibbonArrow" TargetType="RepeatButton">
            <Setter Property="Width" Value="22"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#2B3A5C"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Delay" Value="250"/>
            <Setter Property="Interval" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="bg" Background="#F2FFFFFF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Groupe du ruban : contenu, libelle en bas, separateur a droite -->
        <Style x:Key="RGroup" TargetType="HeaderedContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="10,2,10,0" Margin="0,4">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Text="{TemplateBinding Header}" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SideButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Onglet de volet (Pages / Titres) -->
        <Style x:Key="PaneTab" TargetType="RadioButton" BasedOn="{StaticResource RibbonTab}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="GroupName" Value="paneTabs"/>
        </Style>

        <!-- Pastille « version x.y » des fonctions a venir -->
        <Style x:Key="SoonBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource VersionBadge}"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,2,8,3"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Application.Resources>
</Application>
