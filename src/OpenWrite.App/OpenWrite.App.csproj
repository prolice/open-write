<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenWrite.Core\OpenWrite.Core.csproj" />
    <ProjectReference Include="..\OpenWrite.Docx\OpenWrite.Docx.csproj" />
    <ProjectReference Include="..\OpenWrite.Layout\OpenWrite.Layout.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>OpenWrite</AssemblyName>
    <RootNamespace>OpenWrite.App</RootNamespace>
    <ApplicationIcon>Assets\openwrite.ico</ApplicationIcon>
    <Version>0.3.0</Version>
    <Product>OpenWrite</Product>
    <Description>Traitement de texte (remplacement de Microsoft Word, format .docx)</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\openwrite.ico" />
    <Resource Include="Assets\openwrite-*.png" />
    <!-- Polices de la charte (OFL) : DM Sans et Plus Jakarta Sans, graisses fixes -->
    <Resource Include="Fonts\*.ttf" />
    <None Include="Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Mises a jour automatiques, rapports d'erreur et aide en ligne : portail Azure Static Web Apps
       « openwrite-updates » (offre Free, groupe rg-openwrite-updates, Europe de l'Ouest).
       La cle privee de signature est dans %APPDATA%\OpenWrite\update-signing-key.pem (hors du depot)
       et dans le secret GitHub UPDATE_SIGNING_KEY. -->
  <ItemGroup>
    <AssemblyMetadata Include="UpdateFeed" Value="https://gentle-glacier-0e0efdd03.3.azurestaticapps.net/latest.json" />
    <AssemblyMetadata Include="CrashReportUrl" Value="https://gentle-glacier-0e0efdd03.3.azurestaticapps.net/api/crash" />
    <AssemblyMetadata Include="HelpBase" Value="https://gentle-glacier-0e0efdd03.3.azurestaticapps.net/aide/" />
    <AssemblyMetadata Include="UpdatePublicKey" Value="" />
  </ItemGroup>

</Project>
