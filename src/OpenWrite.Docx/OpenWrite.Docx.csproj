<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenWrite.Core\OpenWrite.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Open XML SDK (licence MIT) : package OPC et parties WordprocessingML -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- document vierge (BlankDocument) : parties relevées sur un document vierge de Word -->
    <EmbeddedResource Include="Blank\*.xml" LogicalName="OpenWrite.Docx.Blank.%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
